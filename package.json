{
  "name": "mini-pose-master",
  "productName": "Mini Pose Master",
  "version": "0.0.1",
  "description": "Rig, pose and arm purchased 3D characters, then bake them into watertight, high-detail STL miniatures.",
  "license": "GPL-3.0-or-later",
  "author": "BearFighter",
  "repository": "github:BearFighter/mini-pose-master",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --publish never",
    "third-party": "node scripts/third-party.mjs",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18",
    "tree-kill": "1.2.2",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
